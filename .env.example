# Optional. Every factor is registered without these.
# Public feeds are used until a key is set.

# St. Louis Fed. Unlocks PCE, the Fed balance sheet, and the BOJ call rate
# if the keyless FRED CSV download is blocked. Also a fallback for CPI and payrolls.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# CryptoQuant Professional. Exchange balances (19) and exchange netflows (31).
CRYPTOQUANT_API_KEY=

# Glassnode. Whale flows, LTH supply, MVRV, SOPR, NUPL (32-36).
GLASSNODE_API_KEY=

# EIA open data. Adds the Henry Hub series beside the NYMEX natural-gas future.
# https://www.eia.gov/opendata/
EIA_API_KEY=

# BLS v2. Raises the public CPI and employment quota when v1 is busy.
# https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# CoinGecko demo or pro key. Optional; the public API is used otherwise.
COINGECKO_DEMO_API_KEY=
COINGECKO_PRO_API_KEY=
